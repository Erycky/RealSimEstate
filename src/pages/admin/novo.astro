---
import Layout from "../../layouts/Layout.astro";
import FormularioImovel from "../../components/react/FormularioImovel";
---

<Layout title="Painel Admin | Cadastrar Imóvel">
  <main class="admin-container animate-fadeIn">
    <div class="admin-header">
      <a href="/" class="btn-voltar">← Voltar para a Home</a>
      <h2>Painel do Corretor</h2>
    </div>

    <div class="form-wrapper">
      <FormularioImovel client:load />
    </div>
  </main>
</Layout>

<style>
  .admin-container {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 16px;
    font-family: sans-serif;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .btn-voltar {
    color: var(--sim-text-dark, #333);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .admin-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--sim-text-dark, #111827);
  }

  .form-wrapper {
    background: #ffffff;
    padding: 32px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid #f0f0f0;
  }

  /* Estilos Globais do Formulário React injetados aqui */
  :global(.form-crud) {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.form-crud h3) {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
  }

  :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.form-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  :global(.count-row) {
    grid-template-columns: 1fr 1fr 1fr;
  }

  :global(.form-group label) {
    font-size: 14px;
    font-weight: 600;
    color: #374151;
  }

  :global(.form-group input),
  :global(.form-group textarea),
  :global(.form-group select) {
    padding: 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }

  :global(.form-group input:focus),
  :global(.form-group textarea:focus),
  :global(.form-group select:focus) {
    border-color: #15803d; /* Cor verde da sua marca */
  }

  :global(.form-group textarea) {
    min-height: 100px;
    resize: vertical;
  }

  :global(.btn-enviar) {
    background: var(--sim-green-gradient, #15803d);
    color: white;
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-top: 12px;
  }

  :global(.btn-enviar:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.alerta) {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  :global(.alerta.sucesso) {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  :global(.alerta.erro) {
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }
</style>
